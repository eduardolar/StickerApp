/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# Claves privadas (la API key de KLIPY). Copia environment.example.ts para crearlos
/src/environments/environment.ts
/src/environments/environment.development.ts

# Firma de Android: si se pierde o se filtra la clave no se podrá actualizar la app en Google Play
/android/keystore.properties
*.jks
*.keystore
/android/local.properties

# Carpeta donde Android Studio deja los APK/AAB firmados a mano
/android/app/release/
