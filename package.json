{
  "name": "sticker-app",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "graphics": "node scripts/render-graphics.mjs",
    "android:icons": "npx --yes @capacitor/assets@3.0.5 generate --android --iconBackgroundColor \"#6366f1\" --iconBackgroundColorDark \"#6366f1\" --splashBackgroundColor \"#020617\" --splashBackgroundColorDark \"#020617\" && node scripts/android-icons.mjs",
    "build:android": "ng build && cap sync android",
    "android:apk": "npm run build:android && node scripts/android-gradle.mjs assembleDebug",
    "android:bundle": "npm run build:android && node scripts/android-gradle.mjs bundleRelease",
    "android:bundle:pruebas": "npm run build:android && node scripts/android-gradle.mjs bundleRelease --allow-test-ads"
  },
  "private": true,
  "packageManager": "npm@10.4.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.3",
    "@capacitor/file-transfer": "^2.0.6",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/share": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/toast": "^8.0.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.0.0",
    "postcss": "^8.5.29",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
